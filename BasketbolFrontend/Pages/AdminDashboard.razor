    // ==================== TAKIM İŞLEMLERİ ====================
    private async Task SaveTeam()
    {
        if (editingTeamId == 0)
            await Http.PostAsJsonAsync("http://localhost:5090/api/Teams", currentTeam);
        else
            await Http.PutAsJsonAsync($"http://localhost:5090/api/Teams/{editingTeamId}", currentTeam);
        
        CancelEdit();
        await LoadAllData();
    }

    private void EditTeam(TeamDto team)
    {
        editingTeamId = team.Id;
        currentTeam = new TeamCreateDto { Name = team.Name, City = team.City, Coach = team.Coach, FoundedYear = team.FoundedYear };
    }

    private async Task DeleteTeam(int id)
    {
        errorMessage = string.Empty; // Önce eski hataları temizle
        
        var response = await Http.DeleteAsync($"http://localhost:5090/api/Teams/{id}");
        
        if (response.IsSuccessStatusCode)
        {
            // Silme başarılıysa listeyi yenile
            await LoadAllData();
        }
        else
        {
            // Veritabanı silmeyi reddettiyse kullanıcıya bilgi ver
            errorMessage = "Bu takımı silemezsiniz! Çünkü bu takıma kayıtlı oyuncular veya fikstürde bu takımın maçları bulunuyor. Önce onları silmelisiniz.";
        }
    }

    // ==================== OYUNCU İŞLEMLERİ ====================
    private async Task SavePlayer()
    {
        if (editingPlayerId == 0)
            await Http.PostAsJsonAsync("http://localhost:5090/api/Players", currentPlayer);
        else
            await Http.PutAsJsonAsync($"http://localhost:5090/api/Players/{editingPlayerId}", currentPlayer);
        
        CancelEdit();
        await LoadAllData();
    }

    private void EditPlayer(PlayerDto player)
    {
        editingPlayerId = player.Id;
        currentPlayer = new PlayerCreateDto { FullName = player.FullName, JerseyNumber = player.JerseyNumber, Position = player.Position, TeamId = player.TeamId };
    }

    private async Task DeletePlayer(int id)
    {
        await Http.DeleteAsync($"http://localhost:5090/api/Players/{id}");
        await LoadAllData();
    }

    // ==================== MAÇ İŞLEMLERİ ====================
    private async Task SaveMatch()
    {
        if (editingMatchId == 0)
            await Http.PostAsJsonAsync("http://localhost:5090/api/Matches", currentMatch);
        else
            await Http.PutAsJsonAsync($"http://localhost:5090/api/Matches/{editingMatchId}", currentMatch);
        
        CancelEdit();
        await LoadAllData();
    }

    private void EditMatch(MatchDto match)
    {
        editingMatchId = match.Id;
        currentMatch = new MatchCreateDto { HomeTeamId = match.HomeTeamId, AwayTeamId = match.AwayTeamId, HomeScore = match.HomeScore, AwayScore = match.AwayScore, MatchDate = match.MatchDate };
    }

    private async Task DeleteMatch(int id)
    {
        await Http.DeleteAsync($"http://localhost:5090/api/Matches/{id}");
        await LoadAllData();
    }

    private async Task Logout()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "jwt_token");
        Navigation.NavigateTo("/login");
    }

