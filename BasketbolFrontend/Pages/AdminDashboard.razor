@page "/admin"
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation
@using System.Net.Http.Headers
@using System.Net.Http.Json

<PageTitle>Yönetim Paneli</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold text-dark">Kontrol Merkezi 👑</h1>
        <button class="btn btn-outline-danger fw-bold rounded-pill px-4 shadow-sm" @onclick="Logout">
            🚪 Çıkış Yap
        </button>
    </div>
    <hr />
    <!--
    <button class="btn btn-danger fw-bold mb-4 w-100 shadow text-white" @onclick="TumLigiTekSeferdeKur">
        🚀 LİGİ KUR: Tüm Takımların Kadrolarını Tek Seferde Veritabanına Yaz!
    </button>
    <button class="btn btn-primary fw-bold mb-4 w-100 shadow text-white" @onclick="FiksturVeMaclariOlustur">
        📅 FİKSTÜRÜ OLUŞTUR: 1. ve 2. Hafta Maçlarını Tanımla
    </button>
    -->
    <ul class="nav nav-pills mb-4 shadow-sm p-2 bg-light rounded">
        <li class="nav-item">
            <button class="nav-link fw-bold @(activeTab == "teams" ? "active" : "text-dark")" @onclick='() => activeTab = "teams"'>🏀 Takımlar</button>
        </li>
        <li class="nav-item">
            <button class="nav-link fw-bold @(activeTab == "players" ? "active" : "text-dark")" @onclick='() => activeTab = "players"'>⛹️‍♂️ Oyuncular</button>
        </li>
        <li class="nav-item">
            <button class="nav-link fw-bold @(activeTab == "matches" ? "active" : "text-dark")" @onclick='() => activeTab = "matches"'>📅 Maçlar</button>
        </li>
    </ul>

    @if (isLoading)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Veriler Yükleniyor...</p>
        </div>
    }
    else
    {
        @if (activeTab == "teams")
        {
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                    <strong>Hata!</strong> @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                </div>
            }

            <div class="row">
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-primary text-white fw-bold">
                            @(editingTeamId == 0 ? "Yeni Takım Ekle" : "Takımı Güncelle")
                        </div>
                        <div class="card-body bg-light">
                            <input type="text" class="form-control mb-2" placeholder="Takım Adı (Örn: Galatasaray)" @bind="currentTeam.Name" />
                            <input type="text" class="form-control mb-2" placeholder="Şehir (Örn: İstanbul)" @bind="currentTeam.City" />
                            <input type="text" class="form-control mb-2" placeholder="Koç (Örn: Zvezdan Mitrovic)" @bind="currentTeam.Coach" />
                            <input type="number" class="form-control mb-3" placeholder="Kuruluş Yılı" @bind="currentTeam.FoundedYear" />
                            
                            <button class="btn btn-success w-100 fw-bold" @onclick="SaveTeam">
                                @(editingTeamId == 0 ? "Ekle" : "Güncelle")
                            </button>
                            @if(editingTeamId != 0) 
                            { 
                                <button class="btn btn-secondary w-100 mt-2" @onclick="CancelEdit">İptal</button> 
                            }
                        </div>
                    </div>
                </div>
                <div class="col-md-8">
                    <table class="table table-hover shadow-sm bg-white rounded">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th><th>Takım Adı</th><th>Şehir</th><th>Koç</th><th>Kuruluş</th><th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var t in teams)
                            {
                                <tr>
                                    <td>@t.Id</td><td class="fw-bold">@t.Name</td><td>@t.City</td><td>@t.Coach</td><td>@t.FoundedYear</td>
                                    <td>
                                        <button class="btn btn-sm btn-warning" @onclick="() => EditTeam(t)">✏️</button>
                                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteTeam(t.Id)">🗑️</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (activeTab == "players")
        {
            <div class="row">
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-success text-white fw-bold">
                            @(editingPlayerId == 0 ? "Yeni Oyuncu Ekle" : "Oyuncuyu Güncelle")
                        </div>
                        <div class="card-body bg-light">
                            <input type="text" class="form-control mb-2" placeholder="Ad Soyad" @bind="currentPlayer.FullName" />
                            <input type="number" class="form-control mb-2" placeholder="Forma No" @bind="currentPlayer.JerseyNumber" />
                            <input type="text" class="form-control mb-2" placeholder="Mevki (Örn: Oyun Kurucu)" @bind="currentPlayer.Position" />
                            <select class="form-select mb-3" @bind="currentPlayer.TeamId">
                                <option value="0">Takım Seçiniz...</option>
                                @foreach(var t in teams) { <option value="@t.Id">@t.Name</option> }
                            </select>
                            
                            <button class="btn btn-success w-100 fw-bold" @onclick="SavePlayer">
                                @(editingPlayerId == 0 ? "Ekle" : "Güncelle")
                            </button>
                            @if(editingPlayerId != 0) { <button class="btn btn-secondary w-100 mt-2" @onclick="CancelEdit">İptal</button> }
                        </div>
                    </div>
                </div>
                <div class="col-md-8">
                    <table class="table table-hover shadow-sm bg-white rounded">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th><th>Oyuncu</th><th>Forma No</th><th>Mevki</th><th>Takımı</th><th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var p in players)
                            {
                                <tr>
                                    <td>@p.Id</td><td class="fw-bold">@p.FullName</td><td>#@p.JerseyNumber</td><td>@p.Position</td>
                                    <td><span class="badge bg-secondary">@p.TeamName</span></td>
                                    <td>
                                        <button class="btn btn-sm btn-warning" @onclick="() => EditPlayer(p)">✏️</button>
                                        <button class="btn btn-sm btn-danger" @onclick="() => DeletePlayer(p.Id)">🗑️</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (activeTab == "matches")
        {
            <div class="row">
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-dark text-white fw-bold">
                            @(editingMatchId == 0 ? "Yeni Maç Ekle" : "Maçı Güncelle")
                        </div>
                        <div class="card-body bg-light">
                            <label class="fw-bold small text-muted">Ev Sahibi</label>
                            <select class="form-select mb-2" @bind="currentMatch.HomeTeamId">
                                <option value="0">Seçiniz...</option>
                                @foreach(var t in teams) { <option value="@t.Id">@t.Name</option> }
                            </select>
                            
                            <label class="fw-bold small text-muted">Deplasman</label>
                            <select class="form-select mb-2" @bind="currentMatch.AwayTeamId">
                                <option value="0">Seçiniz...</option>
                                @foreach(var t in teams) { <option value="@t.Id">@t.Name</option> }
                            </select>

                            <div class="d-flex gap-2 mb-2">
                                <input type="number" class="form-control" placeholder="Ev Skor" @bind="currentMatch.HomeScore" />
                                <input type="number" class="form-control" placeholder="Dep Skor" @bind="currentMatch.AwayScore" />
                            </div>

                            <label class="fw-bold small text-muted">Tarih ve Saat</label>
                            <input type="datetime-local" class="form-control mb-3" @bind="currentMatch.MatchDate" />

                            <button class="btn btn-success w-100 fw-bold" @onclick="SaveMatch">
                                @(editingMatchId == 0 ? "Ekle" : "Güncelle")
                            </button>
                            @if(editingMatchId != 0) { <button class="btn btn-secondary w-100 mt-2" @onclick="CancelEdit">İptal</button> }
                        </div>
                    </div>
                </div>
                <div class="col-md-8">
                    <table class="table table-hover shadow-sm bg-white rounded">
                        <thead class="table-dark">
                            <tr>
                                <th>Ev Sahibi</th><th>Skor</th><th>Deplasman</th><th>Tarih</th><th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var m in matches.OrderByDescending(x => x.MatchDate))
                            {
                                <tr>
                                    <td class="fw-bold text-end">@m.HomeTeamName</td>
                                    <td class="text-center bg-light fw-bold fs-5">@m.HomeScore - @m.AwayScore</td>
                                    <td class="fw-bold text-start">@m.AwayTeamName</td>
                                    <td>@m.MatchDate.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>
                                        <button class="btn btn-sm btn-warning" @onclick="() => EditMatch(m)">✏️</button>
                                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteMatch(m.Id)">🗑️</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@code {
    private string activeTab = "teams";
    private bool isLoading = true;
    private string errorMessage = string.Empty; // EKSİK OLAN SATIR BURAYA EKLENDİ

    // Listeler
    private List<TeamDto> teams = new();
    private List<PlayerDto> players = new();
    private List<MatchDto> matches = new();

    // Form Modelleri (DTO'ların yansıması)
    private TeamCreateDto currentTeam = new();
    private int editingTeamId = 0;

    private PlayerCreateDto currentPlayer = new();
    private int editingPlayerId = 0;

    private MatchCreateDto currentMatch = new() { MatchDate = DateTime.Now };
    private int editingMatchId = 0;

    protected override async Task OnInitializedAsync()
    {
        // 1. JWT Token'ı LocalStorage'dan al
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "jwt_token");
        if (string.IsNullOrEmpty(token))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        // 2. HttpClient'a Bearer Token'ı ekle (Bütün POST/PUT/DELETE işlemleri için yetki sağlar)
        Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

        await LoadAllData();
        isLoading = false;
    }

    private async Task LoadAllData()
    {
        teams = await Http.GetFromJsonAsync<List<TeamDto>>("http://localhost:5090/api/Teams") ?? new();
        players = await Http.GetFromJsonAsync<List<PlayerDto>>("http://localhost:5090/api/Players") ?? new();
        matches = await Http.GetFromJsonAsync<List<MatchDto>>("http://localhost:5090/api/Matches") ?? new();
    }

    private void CancelEdit()
    {
        editingTeamId = 0; currentTeam = new();
        editingPlayerId = 0; currentPlayer = new();
        editingMatchId = 0; currentMatch = new() { MatchDate = DateTime.Now };
    }

